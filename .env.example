# Configuración del Sistema de Contratación Automatizada ESP
APP_NAME=ESPY Contratación Automatizada
APP_ENV=development
DEBUG=True
PORT=8000
HOST=127.0.0.1

# Base de Datos
DATABASE_URL=sqlite:///./backend/espy_contratacion.db

# Almacenamiento Local
STORAGE_DIR=./backend/storage
TEMPLATES_DIR=./backend/templates
MASTER_EXCEL_PATH=./backend/master_excel/Matriz_Contratacion_Maestra.xlsx

# API Key de Google Gemini (Para Fase 2: Extracción y Agentes)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Seguridad y Autenticación
# Para generar una clave segura de 48 bytes en Python ejecute: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=
ADMIN_INITIAL_PASSWORD=
GUEST_INITIAL_PASSWORD=

# Motor Clasificador UNSPSC ("clasico" por defecto o "nuevo")
UNSPSC_MOTOR=clasico
