<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_now_playing"
    android:elevation="12dp"
    android:orientation="vertical"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:paddingStart="14dp"
    android:paddingTop="12dp"
    android:paddingEnd="14dp"
    android:paddingBottom="10dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <FrameLayout
            android:id="@+id/npArtFrame"
            android:layout_width="52dp"
            android:layout_height="52dp">

            <TextView
                android:id="@+id/npArtwork"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:text="♪"
                android:textColor="@android:color/white"
                android:textSize="24sp"
                android:textStyle="bold" />

            <ImageView
                android:id="@+id/npArtImage"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/bg_art_rounded"
                android:importantForAccessibility="no"
                android:scaleType="centerCrop"
                android:visibility="gone" />
        </FrameLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="14dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/npTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="marquee"
                android:marqueeRepeatLimit="marquee_forever"
                android:singleLine="true"
                android:textColor="@android:color/white"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/npArtist"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="#E6FFFFFF"
                android:textSize="13sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/npChips"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:orientation="vertical">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/npLyrics"
                style="@style/NowPlayingChip"
                android:text="@string/lyrics_button"
                app:icon="@drawable/ic_lyrics" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/npMixer"
                style="@style/NowPlayingChip"
                android:layout_marginTop="4dp"
                android:text="@string/mixer_button"
                app:icon="@drawable/ic_tune" />
        </LinearLayout>

        <!-- Solo en modo compacto: reproducir/pausar -->
        <ImageButton
            android:id="@+id/npMiniPlay"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_marginStart="6dp"
            android:background="@drawable/bg_play_button"
            android:contentDescription="@string/np_play_pause"
            android:padding="11dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_play" />

        <!-- Abrir / esconder el panel -->
        <ImageButton
            android:id="@+id/npToggle"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginStart="2dp"
            android:background="@drawable/bg_round_ripple"
            android:contentDescription="@string/np_toggle"
            android:padding="8dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_expand_less" />
    </LinearLayout>

    <!-- Parte que se despliega -->
    <LinearLayout
        android:id="@+id/npFull"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:orientation="vertical">

    <SeekBar
        android:id="@+id/npSeek"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:paddingStart="4dp"
        android:paddingEnd="4dp"
        android:progressBackgroundTint="#66FFFFFF"
        android:progressTint="@android:color/white"
        android:thumbTint="@android:color/white" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingStart="4dp"
        android:paddingEnd="4dp">

        <TextView
            android:id="@+id/npPosition"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textColor="#CCFFFFFF"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/npDuration"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#CCFFFFFF"
            android:textSize="12sp" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:gravity="center"
        android:orientation="horizontal"
        android:paddingTop="2dp"
        android:paddingBottom="4dp">

        <ImageButton
            android:id="@+id/npShuffle"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="@drawable/bg_round_ripple"
            android:contentDescription="@string/np_shuffle"
            android:src="@drawable/ic_shuffle" />

        <ImageButton
            android:id="@+id/npPrev"
            android:layout_width="50dp"
            android:layout_height="50dp"
            android:layout_marginStart="12dp"
            android:background="@drawable/bg_round_ripple"
            android:contentDescription="@string/np_previous"
            android:padding="12dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_skip_previous" />

        <ImageButton
            android:id="@+id/npPlay"
            android:layout_width="60dp"
            android:layout_height="60dp"
            android:layout_marginStart="12dp"
            android:layout_marginEnd="12dp"
            android:background="@drawable/bg_play_button"
            android:contentDescription="@string/np_play_pause"
            android:elevation="6dp"
            android:padding="16dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_play" />

        <ImageButton
            android:id="@+id/npNext"
            android:layout_width="50dp"
            android:layout_height="50dp"
            android:layout_marginEnd="12dp"
            android:background="@drawable/bg_round_ripple"
            android:contentDescription="@string/np_next"
            android:padding="12dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_skip_next" />

        <ImageButton
            android:id="@+id/npRepeat"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="@drawable/bg_round_ripple"
            android:contentDescription="@string/np_repeat"
            android:src="@drawable/ic_repeat" />
    </LinearLayout>
    </LinearLayout>
</LinearLayout>
