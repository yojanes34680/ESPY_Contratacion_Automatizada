<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape>
            <gradient
                android:angle="270"
                android:centerColor="?attr/vpBgTop"
                android:endColor="?attr/vpBgBottom"
                android:startColor="?attr/vpBgMid" />
        </shape>
    </item>
    <item>
        <shape>
            <gradient
                android:centerY="0.9"
                android:endColor="@android:color/transparent"
                android:gradientRadius="600dp"
                android:startColor="?attr/vpAccentSoft"
                android:type="radial" />
        </shape>
    </item>
</layer-list>
