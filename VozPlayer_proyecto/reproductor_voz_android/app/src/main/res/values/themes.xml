<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Tema de escenario: siempre oscuro con acentos de neón -->
    <style name="Theme.VozPlayer.Base" parent="Theme.Material3.Dark.NoActionBar">
        <item name="colorPrimary">?attr/vpAccent</item>
        <item name="colorOnPrimary">?attr/vpOnAccent</item>
        <item name="colorPrimaryContainer">?attr/vpAccent2</item>
        <item name="colorOnPrimaryContainer">@android:color/white</item>
        <item name="colorSecondary">?attr/vpAccent3</item>
        <item name="colorOnSecondary">?attr/vpBgTop</item>
        <item name="colorSecondaryContainer">@color/surface_variant</item>
        <item name="colorOnSecondaryContainer">@android:color/white</item>
        <item name="colorTertiary">?attr/vpAccent4</item>
        <item name="colorSurface">@color/surface</item>
        <item name="colorOnSurface">@android:color/white</item>
        <item name="colorSurfaceVariant">@color/surface_variant</item>
        <item name="colorOnSurfaceVariant">@color/text_secondary</item>
        <item name="colorSurfaceContainerHigh">@color/surface_variant</item>
        <item name="colorSurfaceContainer">@color/surface</item>
        <item name="android:colorBackground">?attr/vpBgTop</item>
        <item name="android:windowBackground">@drawable/bg_app</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">?attr/vpBgBottom</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:textColorPrimary">@color/text_primary</item>
        <item name="android:textColorSecondary">@color/text_secondary</item>
        <item name="colorControlNormal">@android:color/white</item>
        <item name="neonChipStyle">@style/NeonChip</item>
    </style>

    <!-- Plantilla: Neón nocturno -->
    <style name="Theme.VozPlayer" parent="Theme.VozPlayer.Base">
        <item name="vpBgTop">#0B0620</item>
        <item name="vpBgMid">#1B0A3C</item>
        <item name="vpBgBottom">#3A0E4F</item>
        <item name="vpAccent">#FF3D9A</item>
        <item name="vpAccent2">#8B5CF6</item>
        <item name="vpAccent3">#22D3EE</item>
        <item name="vpAccent4">#FF8A3D</item>
        <item name="vpAccentSoft">#40FF3D9A</item>
        <item name="vpOnAccent">#FFFFFF</item>
        <item name="vpCardStart">#E68B5CF6</item>
        <item name="vpCardMid">#D9FF3D9A</item>
        <item name="vpCardEnd">#E6FF8A3D</item>
    </style>

    <!-- Plantilla: Océano -->
    <style name="Theme.VozPlayer.Ocean" parent="Theme.VozPlayer.Base">
        <item name="vpBgTop">#03111F</item>
        <item name="vpBgMid">#062A44</item>
        <item name="vpBgBottom">#0B4A63</item>
        <item name="vpAccent">#00C2FF</item>
        <item name="vpAccent2">#2563EB</item>
        <item name="vpAccent3">#5EEAD4</item>
        <item name="vpAccent4">#38BDF8</item>
        <item name="vpAccentSoft">#4000C2FF</item>
        <item name="vpOnAccent">#03111F</item>
        <item name="vpCardStart">#E61D4ED8</item>
        <item name="vpCardMid">#D90891B2</item>
        <item name="vpCardEnd">#E614B8A6</item>
    </style>

    <!-- Plantilla: Atardecer -->
    <style name="Theme.VozPlayer.Sunset" parent="Theme.VozPlayer.Base">
        <item name="vpBgTop">#170507</item>
        <item name="vpBgMid">#3B0D12</item>
        <item name="vpBgBottom">#6B1D1D</item>
        <item name="vpAccent">#FF7A18</item>
        <item name="vpAccent2">#E11D48</item>
        <item name="vpAccent3">#FDE047</item>
        <item name="vpAccent4">#FB923C</item>
        <item name="vpAccentSoft">#40FF7A18</item>
        <item name="vpOnAccent">#1A0505</item>
        <item name="vpCardStart">#E6BE123C</item>
        <item name="vpCardMid">#D9F97316</item>
        <item name="vpCardEnd">#E6EAB308</item>
    </style>

    <!-- Plantilla: Aurora boreal -->
    <style name="Theme.VozPlayer.Aurora" parent="Theme.VozPlayer.Base">
        <item name="vpBgTop">#021613</item>
        <item name="vpBgMid">#06302B</item>
        <item name="vpBgBottom">#0D3B4F</item>
        <item name="vpAccent">#34D399</item>
        <item name="vpAccent2">#8B5CF6</item>
        <item name="vpAccent3">#67E8F9</item>
        <item name="vpAccent4">#A3E635</item>
        <item name="vpAccentSoft">#4034D399</item>
        <item name="vpOnAccent">#021613</item>
        <item name="vpCardStart">#E60F766E</item>
        <item name="vpCardMid">#D910B981</item>
        <item name="vpCardEnd">#E68B5CF6</item>
    </style>

    <!-- Plantilla: Oro y negro -->
    <style name="Theme.VozPlayer.Gold" parent="Theme.VozPlayer.Base">
        <item name="vpBgTop">#070707</item>
        <item name="vpBgMid">#151310</item>
        <item name="vpBgBottom">#2A2217</item>
        <item name="vpAccent">#F5C542</item>
        <item name="vpAccent2">#B8860B</item>
        <item name="vpAccent3">#FDE68A</item>
        <item name="vpAccent4">#F59E0B</item>
        <item name="vpAccentSoft">#40F5C542</item>
        <item name="vpOnAccent">#1A1205</item>
        <item name="vpCardStart">#E63F2E0C</item>
        <item name="vpCardMid">#D9B8860B</item>
        <item name="vpCardEnd">#E6F5C542</item>
    </style>

    <!-- Plantilla: Rojo pasión -->
    <style name="Theme.VozPlayer.Passion" parent="Theme.VozPlayer.Base">
        <item name="vpBgTop">#120208</item>
        <item name="vpBgMid">#2B0614</item>
        <item name="vpBgBottom">#4A0A1F</item>
        <item name="vpAccent">#FF1F5A</item>
        <item name="vpAccent2">#BE123C</item>
        <item name="vpAccent3">#FDA4AF</item>
        <item name="vpAccent4">#FF6B6B</item>
        <item name="vpAccentSoft">#40FF1F5A</item>
        <item name="vpOnAccent">#FFFFFF</item>
        <item name="vpCardStart">#E69F1239</item>
        <item name="vpCardMid">#D9FF1F5A</item>
        <item name="vpCardEnd">#E6FF8A3D</item>
    </style>

    <!-- Botón de cristal (Letra, Master, Carpeta) -->
    <style name="GlassButton" parent="Widget.Material3.Button.TonalButton">
        <item name="backgroundTint">@color/glass_strong</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="iconTint">?attr/vpAccent3</item>
        <item name="strokeColor">@color/glass_stroke</item>
        <item name="strokeWidth">1dp</item>
        <item name="cornerRadius">22dp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:minHeight">46dp</item>
    </style>

    <!-- Botoncitos Letra / Master dentro del panel "Sonando ahora" -->
    <style name="NowPlayingChip" parent="Widget.Material3.Button.TonalButton">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">34dp</item>
        <item name="android:minHeight">34dp</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:paddingStart">10dp</item>
        <item name="android:paddingEnd">12dp</item>
        <item name="android:textSize">12sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@android:color/white</item>
        <item name="backgroundTint">#40000000</item>
        <item name="iconTint">@android:color/white</item>
        <item name="iconSize">16dp</item>
        <item name="iconPadding">4dp</item>
        <item name="cornerRadius">17dp</item>
        <item name="strokeColor">#40FFFFFF</item>
        <item name="strokeWidth">1dp</item>
    </style>

    <style name="VoiceModeButton" parent="Widget.Material3.Button.OutlinedButton">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_weight">1</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/toggle_text</item>
        <item name="backgroundTint">@color/toggle_bg</item>
        <item name="iconTint">@color/toggle_text</item>
        <item name="iconSize">18dp</item>
        <item name="strokeColor">@color/glass_stroke</item>
    </style>

    <style name="NeonChip" parent="Widget.Material3.Chip.Filter">
        <item name="chipBackgroundColor">@color/chip_bg</item>
        <item name="chipStrokeColor">@color/glass_stroke</item>
        <item name="chipStrokeWidth">1dp</item>
        <item name="android:textColor">@color/chip_text</item>
        <item name="checkedIconTint">?attr/vpOnAccent</item>
        <item name="chipCornerRadius">18dp</item>
    </style>

    <style name="NeonSlider" parent="Widget.Material3.Slider">
        <item name="trackColorActive">?attr/vpAccent</item>
        <item name="trackColorInactive">@color/glass_strong</item>
        <item name="thumbColor">@android:color/white</item>
        <item name="haloColor">?attr/vpAccentSoft</item>
        <item name="tickVisible">false</item>
        <item name="labelBehavior">floating</item>
    </style>

    <style name="GlassCard">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">14dp</item>
        <item name="android:background">@drawable/bg_glass</item>
        <item name="android:orientation">vertical</item>
        <item name="android:padding">16dp</item>
    </style>

    <style name="MixerSection">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:paddingBottom">6dp</item>
        <item name="android:textColor">?attr/vpAccent3</item>
        <item name="android:textSize">13sp</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:letterSpacing">0.12</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="MixerLabel">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:paddingTop">8dp</item>
        <item name="android:textColor">@color/text_secondary</item>
        <item name="android:textSize">14sp</item>
    </style>
</resources>
